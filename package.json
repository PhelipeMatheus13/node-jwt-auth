{
  "name": "jwt-auth",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --watchAll --detectOpenHandles",
    "test:ci": "cross-env NODE_ENV=test jest --forceExit --detectOpenHandles",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPatterns=tests/unit --forceExit --detectOpenHandles",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPatterns=tests/integration --forceExit --detectOpenHandles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [ 
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/src/server.js",
      "/src/app.js",
      "/src/shared/config/database.js",
      "/src/shared/middlewares/http-logger.middleware.js", 
      "/src/shared/utils/logger.js"
    ]
  }
}
