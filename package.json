{
  "name": "jwt-auth",
  "description": "REST API for JWT authentication and user management",
  "version": "1.0.0",
  "author": "Phelipe Matheus",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PhelipeMatheus13/node-jwt-auth"
  },
  "homepage": "https://github.com/PhelipeMatheus13/node-jwt-auth#readme",
  "scripts": {
    "start": "cross-env NODE_ENV=development nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --coverage --watchAll --detectOpenHandles",
    "test:ci": "cross-env NODE_ENV=test jest --coverage --forceExit --detectOpenHandles",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPatterns=tests/unit --forceExit --detectOpenHandles",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPatterns=tests/integration --forceExit --detectOpenHandles"
  },
  "keywords": [
    "jwt",
    "authentication",
    "express",
    "nodejs",
    "api",
    "postgresql",
    "swagger",
    "openapi"
  ],
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/src/server.js",
      "/src/app.js",
      "/src/shared/config/database.js",
      "/src/shared/middlewares/http-logger.middleware.js",
      "/src/shared/utils/logger.js",
      "/src/shared/docs",
      "/src/shared/middlewares/rate-limiter.middleware.js"
    ]
  }
}
